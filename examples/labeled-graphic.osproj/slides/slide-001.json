      {
        "id": "obj-0010",
        "type": "interaction",
        "name": "Model of communication",
        "geometry": {
          "x": 80,
          "y": 230,
          "width": 1120,
          "height": 440,
          "rotation": 0,
          "z": 30
        },
        "content": {
          "kind": "labeledGraphic",
          "orientation": "horizontal",
          "allowMultiple": false,
          "graphic": {
            "src": "assets/images/communication-model.svg",
            "alt": "A diagram of the model of communication: a sender, a message, a channel and a receiver in a row, joined by arrows, with noise shown as a bar underneath them all."
          },
          "items": [
            {
              "id": "item-1",
              "title": "The sender",
              "body": "<p>The person who has something to say. They choose the words, and the way to say them.</p>",
              "image": null,
              "narration": null,
              "x": 12.5,
              "y": 30
            },
            {
              "id": "item-2",
              "title": "The message",
              "body": "<p>What is meant, put into words, tone and gesture. It is not always what is received.</p>",
              "image": null,
              "narration": null,
              "x": 37.5,
              "y": 30
            },
            {
              "id": "item-3",
              "title": "The channel",
              "body": "<p>How the message travels: in person, by email, on a call, in a document.</p>",
              "image": null,
              "narration": null,
              "x": 62.5,
              "y": 30
            },
            {
              "id": "item-4",
              "title": "The receiver",
              "body": "<p>The person who takes the message in and makes their own meaning of it.</p>",
              "image": null,
              "narration": null,
              "x": 87.5,
              "y": 30
            },
            {
              "id": "item-5",
              "title": "Noise",
              "body": "<p>Anything that gets in the way: a loud room, a different language, being distracted, a long day.</p>",
              "image": null,
              "narration": null,
              "x": 92,
              "y": 72
            }
          ]
        },
