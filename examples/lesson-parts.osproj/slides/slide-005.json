        "name": "Feedback conversation",
        "content": {
          "start": "situation-1",
          "you": null,
          "nodes": [
            {
              "id": "situation-1",
              "title": "Totals that do not match",
              "prompt": "What do you do?",
              "lines": [
                {
                  "id": "line-1",
                  "speaker": null,
                  "text": "Alex has handed in a report. The totals on page two do not match the table beneath them.",
                  "narration": null
                },
                {
                  "id": "line-4",
                  "speaker": "maya",
                  "text": "Alex, can we look at page two together? The totals and the table do not agree.",
                  "narration": null
                }
              ],
              "choices": [
                {
                  "id": "choice-1",
                  "label": "Describe what you see and ask Alex how it happened",
                  "next": "situation-2",
                  "effects": [
                    {
                      "variable": "var-1",
                      "add": 1
                    }
                  ],
                  "response": [
                    {
                      "id": "line-5",
                      "speaker": "alex",
                      "text": "I copied the figures from an older file. I should have checked them.",
                      "narration": null
                    }
                  ]
                },
                {
                  "id": "choice-2",
                  "label": "Say that this kind of mistake is careless",
                  "next": "situation-3",
                  "effects": [
                    {
                      "variable": "var-1",
                      "add": -2
                    }
                  ],
                  "response": [
                    {
                      "id": "line-6",
                      "speaker": "alex",
                      "text": "Right. Sorry.",
                      "narration": null
                    }
                  ]
                }
              ]
            },
            {
              "id": "situation-2",
              "title": "A shared fix",
              "prompt": "",
              "lines": [
                {
                  "id": "line-2",
                  "speaker": "maya",
                  "text": "Thank you for saying so. Let us agree how to check figures before they go out.",
                  "narration": null
                }
              ],
              "choices": []
            },
            {
              "id": "situation-3",
              "title": "Alex goes quiet",
              "prompt": "",
              "lines": [
                {
                  "id": "line-3",
                  "speaker": null,
                  "text": "Alex fixes the page and says little for the rest of the week. Maya wonders what she could have said differently.",
                  "narration": null
                }
              ],
              "choices": []
            }
          ],
          "meters": [
            {
              "id": "meter-1",
              "label": "Alex's trust in Maya",
              "variable": "var-1",
              "min": -5,
              "max": 5
            }
          ],
          "allowRetry": true,
          "finishedVariable": null,
          "reflection": "Think of the last feedback you were given. Which of these two ways was it nearer to?"
        },
