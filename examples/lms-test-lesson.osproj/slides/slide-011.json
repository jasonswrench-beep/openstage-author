            {
              "id": "item-1",
              "title": "Asynchronous",
              "body": "<p>Communication in which the other person does not need to respond right away, such as email.</p>",
              "image": null,
              "narration": {
                "script": "Asynchronous. Communication in which the other person does not need to respond right away, such as email.",
                "voice": "af_heart",
                "speed": 1,
