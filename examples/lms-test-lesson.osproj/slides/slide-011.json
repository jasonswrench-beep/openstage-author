                  {
                    "term": "Asynchronous",
                    "ipa": "eɪˈsɪŋkɹənəs"
                  }
                ],
                "audioCache": null
              }
            },
            {
              "id": "item-2",
              "title": "Synchronous",
              "body": "<p>Communication in which people respond in real time, such as a call or a face to face talk.</p>",
              "image": null,
              "narration": {
                "script": "Synchronous. Communication in which people respond in real time, such as a call or a face to face talk.",
                "voice": "af_heart",
                "speed": 1,
                "lang": "en-US",
                "pronunciations": [],
                "audioCache": null
              }
            },
            {
              "id": "item-3",
              "title": "Channel",
              "body": "<p>The route a message travels from sender to receiver.</p>",
              "image": null,
              "narration": {
                "script": "Channel. The route a message travels from sender to receiver.",
                "voice": "af_heart",
                "speed": 1,
                "lang": "en-US",
                "pronunciations": [],
                "audioCache": null
              }
            },
            {
              "id": "item-4",
              "title": "Channel overload",
              "body": "<p>Receiving more messages through a channel than a person can process.</p>",
              "image": null,
              "narration": {
                "script": "Channel overload. Receiving more messages through a channel than a person can process.",
                "voice": "af_heart",
                "speed": 1,
                "lang": "en-US",
                "pronunciations": [],
                "audioCache": null
              }
            },
            {
              "id": "item-5",
              "title": "Media richness",
              "body": "<p>How many cues, such as tone and expression, a channel can carry, and how quickly it supports feedback.</p>",
              "image": null,
              "narration": {
                "script": "Media richness. How many cues, such as tone and expression, a channel can carry, and how quickly it supports feedback.",
                "voice": "af_heart",
