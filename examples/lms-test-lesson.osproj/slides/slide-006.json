            },
            {
              "id": "item-2",
              "title": "Phone or video call",
              "body": "<p>Carries tone and, on video, expression. Feedback is fast, but there is usually no automatic record.</p><p>Good for discussions that need quick back and forth.</p>",
              "image": null,
              "narration": {
                "script": "Phone or video call. Carries tone and, on video, expression. Feedback is fast, but there is usually no automatic record. Good for discussions that need quick back and forth.",
