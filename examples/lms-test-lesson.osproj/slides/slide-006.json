              }
            },
            {
              "id": "item-3",
              "title": "Chat",
              "body": "<p>Fast and informal, and easy to answer in a moment. Short messages can lose tone, and long threads are hard to follow.</p><p>Good for quick questions and updates.</p>",
              "image": null,
              "narration": {
                "script": "Chat. Fast and informal, and easy to answer in a moment. Short messages can lose tone, and long threads are hard to follow. Good for quick questions and updates.",
