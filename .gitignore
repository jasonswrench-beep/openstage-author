# Generated narration audio. Regenerable from the narration script in the
# project file, keyed by content hash. Never commit this.
**/.cache/

# Downloaded model weights. Fetched on demand, never bundled in the repo.
models/

# Build output
dist/
build/
node_modules/

# Personal Claude Code instructions, not shared with the project
CLAUDE.local.md

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Rust build output and generated editor files
target/
editor/web/main.js
editor/web/style.css
editor/src-tauri/gen/

# Also ignored by GitHub's Rust template
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Python bytecode
__pycache__/
*.pyc

# The speech recogniser (whisper.cpp) built by BUILD SPEECH RECOGNISER.bat
speech/

# Licence texts for a package given to other people: made by tools/check_licences.py --texts
editor/THIRD-PARTY-LICENSES.txt
local-settings.bat
