{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openstage.example/schema/project.schema.json",
  "title": "OpenStage project.json",
  "description": "The project manifest. See docs/format-spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "stage", "variables", "theme", "credits", "completion", "scenes"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "language", "created", "modified"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "created": { "type": "string", "format": "date" },
        "modified": { "type": "string", "format": "date" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "credits": { "type": "boolean" },
    "characters": {
      "description": "Optional. The cast: the people a course can show and give a voice, shared by every scenario and choice of character in it. An id of 'you' is not allowed, because 'you' means the learner.",
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/character" }
    },
    "banks": {
      "description": "Optional. Question banks: runs of slides of which each learner is shown some, picked at random when they begin and kept with their progress. A bank shows draw of its slides (all of them, if it has fewer), in the author's order or mixed. The slides shown take the place of the bank's first slide, so a bank is meant to be a run of slides that sit together.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slides", "draw", "shuffle"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "slides": { "type": "array", "minItems": 2, "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "draw": { "type": "integer", "minimum": 1, "maximum": 200, "description": "How many of the bank's slides each learner is shown." },
          "shuffle": { "type": "boolean", "description": "Show the slides picked in a random order, not the author's." }
        }
      }
    },
    "sources": {
      "description": "Optional. The PowerPoint decks slides were imported from. An imported slide and its shapes name a deck by its id here. The deck's size and where it was placed on the stage are kept, so a changed deck is placed the same way.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "importedAt", "slideWidth", "slideHeight", "pixelsPerInch", "offsetX", "offsetY"],
        "properties": {
          "id": { "type": "string", "pattern": "^deck-[a-z0-9]{3,12}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 260, "description": "The deck's file name, as a reminder of which file it was." },
          "importedAt": { "type": "string", "format": "date-time" },
          "syncedAt": { "type": "string", "format": "date-time", "description": "The last time a changed deck was brought forward." },
          "slideWidth": { "type": "integer", "minimum": 1, "description": "The deck's slide width in its own units (English Metric Units, 914,400 to the inch)." },
          "slideHeight": { "type": "integer", "minimum": 1 },
          "pixelsPerInch": { "type": "number", "exclusiveMinimum": 0, "description": "How big the deck was drawn on the stage: stage pixels to each inch of the deck's slide." },
          "offsetX": { "type": "number", "description": "Stage pixels from the stage's left edge to the deck's left edge (when the deck is a different shape from the stage)." },
          "offsetY": { "type": "number" },
          "seen": { "type": "array", "maxItems": 2000, "items": { "type": "string", "minLength": 1 }, "description": "The deck's own numbers for every slide it had when it was last imported or brought up to date, so a slide the author left out or deleted is told apart from one the deck added." }
        }
      }
    },
    "sourceExclude": {
      "description": "Optional. Files and folders left out of the source/ copy of the project that a published package carries. A name with no slash matches that name at any depth; a path with a slash is relative to the project folder.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^/\\\\][^\\\\]*$",
        "not": { "pattern": "(^|/)\\.\\.(/|$)" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slides"],
      "properties": {
        "slides": {
          "enum": ["all", "last"],
          "description": "all: the learner has seen every slide. last: the learner has reached the last slide. Either way every quiz must also be finished."
        }
      }
    },
    "theme": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": { "ref": { "const": "theme.json" } }
        }
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slides"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "slides": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "voice", "picture"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "maxLength": 120, "description": "A few words on who this is, such as 'Nurse manager'. May be empty." },
        "voice": { "type": "string", "minLength": 1, "description": "The narration voice that reads this person's lines." },
        "picture": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["src", "alt", "decorative"],
              "properties": {
                "src": { "$ref": "object.schema.json#/$defs/assetPath" },
                "alt": { "type": "string" },
                "decorative": { "type": "boolean" }
              }
            }
          ]
        },
        "poses": {
          "description": "Optional. More pictures of this person, each in a pose, to show with a line of a scenario. A pose's id is unique for the person; the label is what a menu says. The files are in the project's assets.",
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "src"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "src": { "$ref": "object.schema.json#/$defs/assetPath" }
            }
          }
        },
        "library": {
          "description": "Optional. Where this person came from in the library of people (a character pack and a person in it), so the editor can offer more of their poses. The course never uses it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["pack", "person"],
          "properties": {
            "pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
            "person": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,29}$" }
          }
        }
      }
    },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "initial"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["number", "boolean", "string"] },
        "initial": { "type": ["number", "boolean", "string"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": { "properties": { "initial": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } } },
          "then": { "properties": { "initial": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "properties": { "initial": { "type": "string" } } }
        }
      ]
    }
  }
}
